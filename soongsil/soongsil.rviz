Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Global Options:
    Fixed Frame: map
    Background Color: 20; 22; 28
    Frame Rate: 20
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Color: 60; 60; 70
      Plane Cell Count: 60
      Cell Size: 5
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: false
      Marker Scale: 3
      Frame Timeout: 15
      Update Interval: 0
    - Class: rviz_default_plugins/PointCloud2
      Name: PointCloudMap
      Enabled: true
      Topic:
        Value: /map/pointcloud_map
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Style: Points
      Size (Pixels): 2
      Decay Time: 0
      Color Transformer: FlatColor
      Color: 90; 100; 120
      Use Fixed Frame: true
    - Class: rviz_default_plugins/PointCloud2
      Name: LiDAR
      Enabled: true
      Topic:
        Value: /localization/util/downsample/pointcloud
        Depth: 5
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Style: Points
      Size (Pixels): 3
      Decay Time: 1.0
      Color Transformer: AxisColor
      Axis: Z
    - Class: rviz_default_plugins/Odometry
      Name: Ego
      Enabled: true
      Topic:
        Value: /localization/kinematic_state
        Reliability Policy: Reliable
      Shape: Arrow
      Keep: 1
      Covariance: {Value: false}
      Color: 0; 200; 255
    - Class: rviz_default_plugins/MarkerArray
      Name: VectorMap
      Enabled: true
      Topic: {Value: /map/vector_map_marker, Durability Policy: Transient Local, Reliability Policy: Reliable}
  Views:
    Current:
      Class: rviz_default_plugins/ThirdPersonFollower
      Name: FollowEgo
      Target Frame: base_link
      Distance: 40
      Pitch: 0.6
      Near Clip Distance: 0.5
